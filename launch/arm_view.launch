<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="false"/>

  <rosparam file="$(find stsm_madp)/config/handover_scene.yaml"
            command="load" ns="/stsm_handover/scene"/>

  <include file="$(find stsm_madp)/launch/elfin3_eldercare.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <node if="$(arg rviz)" pkg="stsm_madp" type="social_field_viz_node.py"
        name="stsm_social_field_viz" output="screen">
    <param name="target" value="arm"/>
    <param name="path_yaw_offset" value="-1.57079632679"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find stsm_madp)/rviz/arm_social_field.rviz"/>
</launch>
