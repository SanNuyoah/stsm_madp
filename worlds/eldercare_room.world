<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="eldercare_room">
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room walls (simple) -->
    <model name="wall_back">
      <static>true</static>
      <pose>0 -2.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 0.1 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.1 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient></material></visual>
      </link>
    </model>

    <!-- Table next to the arm -->
    <model name="care_table">
      <static>true</static>
      <pose>0.55 0.0 0.37 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 1.0 0.74</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.0 0.74</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Bed (for wheelchair scenario) -->
    <model name="bed">
      <static>true</static>
      <pose>-1.6 -1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 2.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 2.0 0.5</size></box></geometry>
          <material><ambient>0.3 0.4 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- Seated elderly person and safety cue volumes.
         Arm base is at world (0,0,0.74). Person faces -x toward the arm.
         These visuals are aligned with config/handover_scene.yaml:
         head world (0.78,0,1.35), chest world (0.78,0,1.05),
         hand world (0.42,0,0.95). -->
    <model name="elderly_person">
      <static>true</static>
      <pose>0.78 0.0 0.0 0 0 0</pose>

      <link name="torso">
        <pose>0 0 1.05 0 0 0</pose>
        <visual name="body">
          <geometry><cylinder><radius>0.18</radius><length>0.58</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.36 0.78 1</ambient>
            <diffuse>0.12 0.36 0.78 1</diffuse>
          </material>
        </visual>
        <visual name="chest_risk">
          <transparency>0.58</transparency>
          <geometry><sphere><radius>0.30</radius></sphere></geometry>
          <material>
            <ambient>0.95 0.22 0.12 0.42</ambient>
            <diffuse>0.95 0.22 0.12 0.42</diffuse>
          </material>
        </visual>
      </link>

      <link name="head">
        <pose>0 0 1.35 0 0 0</pose>
        <visual name="head">
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material>
            <ambient>0.95 0.73 0.50 1</ambient>
            <diffuse>0.95 0.73 0.50 1</diffuse>
          </material>
        </visual>
        <visual name="head_risk">
          <transparency>0.55</transparency>
          <geometry><sphere><radius>0.24</radius></sphere></geometry>
          <material>
            <ambient>0.95 0.08 0.08 0.45</ambient>
            <diffuse>0.95 0.08 0.08 0.45</diffuse>
          </material>
        </visual>
      </link>

      <link name="reaching_arm">
        <pose>-0.18 0 0.95 0 1.5708 0</pose>
        <visual name="forearm">
          <geometry><cylinder><radius>0.035</radius><length>0.36</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.73 0.50 1</ambient>
            <diffuse>0.95 0.73 0.50 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="hand">
        <pose>-0.36 0 0.95 0 0 0</pose>
        <visual name="hand">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material>
            <ambient>0.98 0.62 0.20 1</ambient>
            <diffuse>0.98 0.62 0.20 1</diffuse>
          </material>
        </visual>
        <visual name="handover_target">
          <transparency>0.50</transparency>
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material>
            <ambient>0.00 0.63 0.53 0.50</ambient>
            <diffuse>0.00 0.63 0.53 0.50</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Object to hand over (cup) on the table, within arm reach -->
    <model name="cup">
      <pose>0.34 0.16 0.79 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass>
          <inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <gui><camera name="user_camera"><pose>-2.5 -2.5 2.2 0 0.4 0.7</pose></camera></gui>
  </world>
</sdf>
