<launch>
  <!-- STSM-MADP wheelchair bedside berthing scenario -->
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <!-- Kept at the production value by default.  The diff-drive probe uses a
       raised spawn only while it isolates wheel-joint actuation. -->
  <arg name="spawn_z" default="0.05"/>
  <arg name="wheel_mu" default="1.0"/>
  <arg name="wheel_fdir1_enabled" default="false"/>
  <arg name="wheel_lateral_slip_enabled" default="false"/>
  <arg name="wheel_lateral_slip" default="0.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find stsm_madp)/worlds/eldercare_room.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <param name="wheelchair/robot_description"
         command="$(find xacro)/xacro '$(find stsm_madp)/urdf/wheelchair.xacro' wheel_mu:=$(arg wheel_mu) wheel_fdir1_enabled:=$(arg wheel_fdir1_enabled) wheel_lateral_slip_enabled:=$(arg wheel_lateral_slip_enabled) wheel_lateral_slip:=$(arg wheel_lateral_slip)"/>

  <node name="wc_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false"
        output="screen"
        args="-urdf -model wheelchair -param wheelchair/robot_description -x 2.0 -y 1.5 -z $(arg spawn_z) -Y -2.4"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="wc_state_publisher" ns="wheelchair">
    <param name="publish_frequency" type="double" value="50.0"/>
  </node>

  <rosparam file="$(find stsm_madp)/config/wheelchair_control.yaml" command="load"/>
  <node name="wc_controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen" ns="wheelchair"
        args="joint_state_controller diff_drive_controller"/>
</launch>
