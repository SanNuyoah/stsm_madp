<launch>
  <!-- Dedicated physical-actuation probe.  It never starts wheelchair_node
       or any STSM planner component. -->
  <arg name="gui" default="false"/>
  <arg name="suspended" default="false"/>
  <arg name="duration_s" default="4.0"/>
  <arg name="spawn_z" default="0.05"/>
  <arg name="wheel_mu" default="1.0"/>
  <arg name="wheel_effort_limit" default="10.0"/>
  <arg name="wheel_velocity_limit" default="4.0"/>
  <arg name="wheel_fdir1_enabled" default="false"/>
  <arg name="wheel_lateral_slip_enabled" default="false"/>
  <arg name="wheel_lateral_slip" default="0.0"/>
  <arg name="wheel_contact_stiffness_enabled" default="false"/>
  <arg name="wheel_contact_kp" default="10000000.0"/>
  <arg name="wheel_contact_kd" default="1.0"/>
  <arg name="wheel_contact_min_depth_enabled" default="false"/>
  <arg name="wheel_contact_min_depth" default="0.001"/>
  <arg name="wheel_contact_max_vel_enabled" default="false"/>
  <arg name="wheel_contact_max_vel" default="0.1"/>
  <arg name="ode_sor_pgs_iterations" default="0"/>
  <arg name="ode_contact_surface_layer" default="-1.0"/>
  <arg name="ode_contact_max_correcting_vel" default="-1.0"/>
  <arg name="output_path" default="/tmp/wheelchair_diff_drive_probe.json"/>

  <include file="$(find stsm_madp)/launch/wheelchair_eldercare.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="spawn_z" value="$(arg spawn_z)"/>
    <arg name="wheel_mu" value="$(arg wheel_mu)"/>
    <arg name="wheel_effort_limit" value="$(arg wheel_effort_limit)"/>
    <arg name="wheel_velocity_limit" value="$(arg wheel_velocity_limit)"/>
    <arg name="wheel_fdir1_enabled" value="$(arg wheel_fdir1_enabled)"/>
    <arg name="wheel_lateral_slip_enabled" value="$(arg wheel_lateral_slip_enabled)"/>
    <arg name="wheel_lateral_slip" value="$(arg wheel_lateral_slip)"/>
    <arg name="wheel_contact_stiffness_enabled" value="$(arg wheel_contact_stiffness_enabled)"/>
    <arg name="wheel_contact_kp" value="$(arg wheel_contact_kp)"/>
    <arg name="wheel_contact_kd" value="$(arg wheel_contact_kd)"/>
    <arg name="wheel_contact_min_depth_enabled" value="$(arg wheel_contact_min_depth_enabled)"/>
    <arg name="wheel_contact_min_depth" value="$(arg wheel_contact_min_depth)"/>
    <arg name="wheel_contact_max_vel_enabled" value="$(arg wheel_contact_max_vel_enabled)"/>
    <arg name="wheel_contact_max_vel" value="$(arg wheel_contact_max_vel)"/>
  </include>

  <node pkg="stsm_madp" type="wheelchair_diff_drive_probe.py"
        name="wheelchair_diff_drive_probe" output="screen">
    <param name="suspended" value="$(arg suspended)"/>
    <param name="duration_s" value="$(arg duration_s)"/>
    <param name="spawn_z" value="$(arg spawn_z)"/>
    <param name="wheel_mu" value="$(arg wheel_mu)"/>
    <param name="wheel_effort_limit" value="$(arg wheel_effort_limit)"/>
    <param name="wheel_velocity_limit" value="$(arg wheel_velocity_limit)"/>
    <param name="wheel_fdir1_enabled" value="$(arg wheel_fdir1_enabled)"/>
    <param name="wheel_lateral_slip_enabled" value="$(arg wheel_lateral_slip_enabled)"/>
    <param name="wheel_lateral_slip" value="$(arg wheel_lateral_slip)"/>
    <param name="wheel_contact_stiffness_enabled" value="$(arg wheel_contact_stiffness_enabled)"/>
    <param name="wheel_contact_kp" value="$(arg wheel_contact_kp)"/>
    <param name="wheel_contact_kd" value="$(arg wheel_contact_kd)"/>
    <param name="wheel_contact_min_depth_enabled" value="$(arg wheel_contact_min_depth_enabled)"/>
    <param name="wheel_contact_min_depth" value="$(arg wheel_contact_min_depth)"/>
    <param name="wheel_contact_max_vel_enabled" value="$(arg wheel_contact_max_vel_enabled)"/>
    <param name="wheel_contact_max_vel" value="$(arg wheel_contact_max_vel)"/>
    <param name="ode_sor_pgs_iterations" value="$(arg ode_sor_pgs_iterations)"/>
    <param name="ode_contact_surface_layer" value="$(arg ode_contact_surface_layer)"/>
    <param name="ode_contact_max_correcting_vel" value="$(arg ode_contact_max_correcting_vel)"/>
    <param name="output_path" value="$(arg output_path)"/>
  </node>
</launch>
