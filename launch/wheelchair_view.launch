<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="false"/>

  <include file="$(find stsm_madp)/launch/wheelchair_eldercare.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <node if="$(arg rviz)" pkg="stsm_madp" type="social_field_viz_node.py"
        name="stsm_social_field_viz" output="screen">
    <param name="target" value="wheelchair"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find stsm_madp)/rviz/wheelchair_social_field.rviz"/>
</launch>
